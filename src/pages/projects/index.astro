---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { SITE_TITLE } from '../../site.config';

// Featured projects first, then newest first within each group.
const projects = (await getCollection('projects')).sort(
  (a, b) =>
    Number(b.data.featured) - Number(a.data.featured) || b.data.date.localeCompare(a.data.date),
);
---

<Base
  title={`Projects · ${SITE_TITLE}`}
  description="Research and engineering projects by Qiyi (Lucas) Xie."
>
  <h1>Projects</h1>
  <ul class="grid">
    {projects.map((project) => (
      <li>
        <ProjectCard project={project} />
      </li>
    ))}
  </ul>
</Base>

<style>
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 20px;
    margin: 20px 0 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 760px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
