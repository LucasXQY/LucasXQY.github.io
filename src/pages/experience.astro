---
import Base from '../layouts/Base.astro';
import { loadExperience } from '../lib/data';
import { SITE_TITLE } from '../site.config';

const sections = loadExperience();
---

<Base
  title={`Experience · ${SITE_TITLE}`}
  description="Teaching, research, industry and leadership roles held by Qiyi (Lucas) Xie."
>
  <div class="experience">
    <h1>Experience</h1>
    {sections.map((section) => (
      <section>
        <h2>{section.section}</h2>
        <ul class="entries">
          {section.entries.map((entry) => (
            <li class="entry">
              <h3 class="role">{entry.role}</h3>
              <p class="org">
                {entry.org}
                {entry.location !== undefined && ` · ${entry.location}`}
              </p>
              <p class="when mono">{entry.dates}</p>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</Base>

<style>
  .experience {
    max-width: 52rem;
  }

  section {
    margin-top: 36px;
  }

  h2 {
    margin: 0;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--border);
    font-size: 20px;
    font-weight: 700;
  }

  .entries {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Narrow: role, organisation, dates stacked. Wide: dates in a right-hand column. */
  .entry {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2px 24px;
    margin-top: 18px;
  }

  @media (min-width: 640px) {
    .entry {
      grid-template-columns: minmax(0, 1fr) auto;
    }

    .role,
    .org {
      grid-column: 1;
    }

    .when {
      grid-column: 2;
      grid-row: 1 / span 2;
      text-align: right;
      white-space: nowrap;
    }
  }

  .role {
    margin: 0;
    font-size: 16px;
    font-weight: 650;
    line-height: 1.4;
  }

  .org {
    margin: 0;
    color: var(--text-2);
    font-size: 14px;
  }

  .when {
    margin: 0;
    color: var(--text-3);
    font-size: 12px;
    line-height: 1.7;
  }
</style>
