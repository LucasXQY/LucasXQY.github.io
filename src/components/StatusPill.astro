---
import { statusLabel } from '../lib/publications';
import type { PubStatus } from '../schemas';

interface Props {
  status: PubStatus;
}

const { status } = Astro.props;
const label = statusLabel(status);
---

{label !== null && (
  <span class:list={['pill', 'mono', status]} data-testid="status-pill">
    {label}
  </span>
)}

<style>
  .pill {
    display: inline-block;
    padding: 1px 8px;
    border: 1px solid var(--text-3);
    border-radius: 999px;
    color: var(--text-2);
    font-size: 11.5px;
    line-height: 1.5;
    text-decoration: none;
    white-space: nowrap;
  }

  .pill.accepted {
    border-color: var(--accent);
    color: var(--accent);
  }

  .pill.preprint {
    border-color: var(--accent-2);
    color: var(--text-2);
  }
</style>
