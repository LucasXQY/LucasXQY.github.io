---
import { SITE_TITLE } from '../site.config';
import Achievements from './Achievements.astro';

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="footer-inner mono">
    <span>
      © {year} {SITE_TITLE} · built with Astro
    </span>
    <Achievements />
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--border);
    background: var(--bg);
    font-size: 12px;
    color: var(--text-3);
  }

  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 6px 16px;
    max-width: var(--content-max);
    margin-inline: auto;
    padding: 10px var(--page-pad);
  }
</style>
