---
// The terminal easter egg: a command line docked to the bottom of the page, shown when the
// backtick key is pressed (or window.qxOpenTerminal() is called). The commands live in
// src/lib/eggs/terminal.ts and the copy in src/data/eggs.ts; this file is the dialog and its wiring.
//
// Everything the terminal prints, including what the visitor typed, is added with textContent.
// Nothing here may turn a string into markup (no HTML-setting properties). `.egg` hides it in print.
import { loadPublications } from '../lib/data';

// The paper ids and titles `open` works with, read from the data at build time.
const pubs = loadPublications().map(({ id, title }) => ({ id, title }));
---

<div
  class="terminal egg"
  role="dialog"
  aria-modal="true"
  aria-label="Terminal"
  data-pubs={JSON.stringify(pubs)}
  hidden
>
  <div class="term-head">
    <span class="term-title" aria-hidden="true">
      terminal
    </span>
    <button type="button" class="term-close" aria-label="Close terminal">
      <span aria-hidden="true">×</span>
    </button>
  </div>
  <div
    class="term-out"
    role="log"
    aria-live="polite"
    aria-label="Terminal output"
    tabindex="0"
  ></div>
  <form class="term-form" autocomplete="off">
    <span class="term-prompt" aria-hidden="true">
      $
    </span>
    <input
      class="term-in"
      type="text"
      autocomplete="off"
      autocapitalize="off"
      spellcheck="false"
      aria-label="Command"
    />
  </form>
</div>

<script>
  import { TERMINAL } from '../data/eggs';
  import { store } from '../lib/achievements';
  import { isKnownCommand, runCommand, type TermContext } from '../lib/eggs/terminal';
  import { setTheme } from '../lib/theme';

  const PAGES = ['about', 'publications', 'projects', 'cv', 'misc'];

  const dialog = document.querySelector<HTMLElement>('.terminal');
  const out = dialog?.querySelector<HTMLElement>('.term-out');
  const form = dialog?.querySelector<HTMLFormElement>('.term-form');
  const closeButton = dialog?.querySelector<HTMLButtonElement>('.term-close');
  const input = dialog?.querySelector<HTMLInputElement>('.term-in');

  if (dialog && out && form && input && closeButton) {
    const pubs: TermContext['pubs'] = JSON.parse(dialog.dataset.pubs ?? '[]');

    /** What had focus when the terminal opened, so closing can give it back. */
    let previous: HTMLElement | null = null;
    /** Commands entered so far (oldest first); `cursor` is the entry ArrowUp/ArrowDown is showing. */
    const history: string[] = [];
    let cursor = 0;
    let draft = '';

    const isOpen = () => !dialog.hidden;

    /** One line of output. textContent only: the text may be exactly what the visitor typed. */
    const print = (text: string, className = ''): void => {
      const line = document.createElement('div');
      line.className = `term-line ${className}`.trim();
      line.textContent = text;
      out.append(line);
      out.scrollTop = out.scrollHeight;
    };

    const clear = (): void => out.replaceChildren();

    const open = (): void => {
      if (isOpen()) {
        input.focus();
        return;
      }
      const active = document.activeElement;
      previous = active instanceof HTMLElement && active !== document.body ? active : null;
      dialog.hidden = false;
      clear();
      TERMINAL.banner.forEach((line) => print(line));
      input.value = '';
      cursor = history.length;
      input.focus();
    };

    const close = (): void => {
      if (!isOpen()) return;
      // Blur first: a hidden element can stay document.activeElement until the next frame, and
      // the backtick listener would then take a quick Esc-then-backtick for typing in a field.
      if (dialog.contains(document.activeElement)) (document.activeElement as HTMLElement).blur();
      dialog.hidden = true;
      const back = previous;
      previous = null;
      if (back?.isConnected) back.focus();
    };

    const ctx: TermContext = {
      pages: PAGES,
      pubs,
      navigate: (path) => location.assign(path),
      setTheme,
      close,
      clear,
    };

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const value = input.value;
      input.value = '';
      print(`$ ${value}`, 'term-echo');

      const command = value.trim();
      if (command && history[history.length - 1] !== command) history.push(command);
      cursor = history.length;

      // Any command the terminal understands lights the star (a bad argument still counts), and
      // it does so before the command runs: cd and open may leave the page.
      if (isKnownCommand(command)) store.unlock('terminal');
      runCommand(command, ctx).forEach((line) => print(line));
    });

    input.addEventListener('keydown', (event) => {
      if (event.key !== 'ArrowUp' && event.key !== 'ArrowDown') return;
      event.preventDefault();
      if (event.key === 'ArrowUp') {
        if (cursor === 0) return;
        if (cursor === history.length) draft = input.value;
        cursor -= 1;
        input.value = history[cursor] ?? '';
      } else {
        if (cursor >= history.length) return;
        cursor += 1;
        input.value = cursor === history.length ? draft : (history[cursor] ?? '');
      }
      input.setSelectionRange(input.value.length, input.value.length);
    });

    // The visible way out, for a touch screen with no Esc key. Same close as Esc and `exit`; the
    // click must not also reach the handler below, which would send focus to the hidden input.
    closeButton.addEventListener('click', (event) => {
      event.stopPropagation();
      close();
    });

    // A click on the terminal goes to the input, unless the visitor is selecting text to copy.
    dialog.addEventListener('click', () => {
      if (!window.getSelection()?.toString()) input.focus();
    });

    /** True for fields where a backtick is just a character being typed. */
    const isTypingTarget = (target: EventTarget | null): boolean =>
      target instanceof HTMLElement &&
      (target.isContentEditable || ['INPUT', 'TEXTAREA', 'SELECT'].includes(target.tagName));

    /** Keeps Tab and Shift+Tab inside the dialog, including when focus has strayed outside it. */
    const trapTab = (event: KeyboardEvent): void => {
      const items = Array.from(
        dialog.querySelectorAll<HTMLElement>(
          'input:not([disabled]), button:not([disabled]), a[href], [tabindex]:not([tabindex="-1"])',
        ),
      );
      const first = items[0];
      const last = items[items.length - 1];
      if (!first || !last) return;
      const active = document.activeElement;
      if (!dialog.contains(active)) {
        event.preventDefault();
        (event.shiftKey ? last : first).focus();
      } else if (event.shiftKey && active === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && active === last) {
        event.preventDefault();
        first.focus();
      }
    };

    document.addEventListener('keydown', (event) => {
      if (!isOpen()) {
        const plain = !event.ctrlKey && !event.altKey && !event.metaKey;
        if (event.key === '`' && plain && !isTypingTarget(event.target)) {
          event.preventDefault(); // otherwise the backtick would be typed into the new input
          open();
        }
        return;
      }
      // A modal dialog (the footer stars) can be open over the terminal. Escape and Tab then
      // belong to it: handling them here would close the terminal instead of the dialog, and
      // trapTab would move focus to an element the modal has made inert.
      if (document.querySelector('dialog[open]')) return;
      if (event.key === 'Escape') {
        event.preventDefault();
        close();
      } else if (event.key === 'Tab') {
        trapTab(event);
      }
    });

    (window as Window & { qxOpenTerminal?: () => void }).qxOpenTerminal = open;
  }
</script>

<style>
  .terminal {
    position: fixed;
    inset: auto 0 0;
    z-index: 1000;
    display: flex;
    flex-direction: column;
    max-height: 40vh;
    max-height: 40dvh;
    border-top: 1px solid var(--border);
    background: var(--surface);
    box-shadow: 0 -8px 24px rgb(0 0 0 / 0.25);
    color: var(--text-1);
    font-family: var(--font-mono);
    font-size: 14px;
    line-height: 1.5;
  }

  /* display: flex above would otherwise beat the browser's [hidden] rule. */
  .terminal[hidden] {
    display: none;
  }

  .term-head {
    display: flex;
    flex: none;
    align-items: center;
    justify-content: space-between;
    padding: 2px 6px 0 16px;
  }

  .term-title {
    color: var(--text-3);
    font-size: 12px;
  }

  .term-close {
    width: 32px;
    height: 32px;
    padding: 0;
    border: 0;
    border-radius: 4px;
    background: transparent;
    color: var(--text-2);
    font: inherit;
    font-size: 20px;
    line-height: 1;
    cursor: pointer;
  }

  .term-close:hover {
    color: var(--text-1);
  }

  .term-out {
    flex: 1 1 auto;
    min-height: 0;
    padding: 12px 16px 4px;
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .term-out:focus-visible {
    outline-offset: -2px;
  }

  /* The lines are created by the script, so they carry no Astro scope attribute. */
  .term-out :global(.term-line) {
    color: var(--text-1);
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .term-out :global(.term-echo) {
    color: var(--text-2);
  }

  .term-form {
    display: flex;
    flex: none;
    align-items: center;
    gap: 8px;
    margin: 0;
    padding: 6px 16px 12px;
  }

  .term-prompt {
    color: var(--accent);
    user-select: none;
  }

  .term-in {
    flex: 1;
    min-width: 0;
    padding: 2px 4px;
    border: 0;
    border-radius: 2px;
    background: transparent;
    color: var(--text-1);
    caret-color: var(--accent);
    font: inherit;
  }

  /* 16px keeps iOS from zooming the page when the input takes focus. */
  @media (max-width: 640px) {
    .terminal {
      font-size: 13px;
    }

    .term-in {
      font-size: 16px;
    }
  }
</style>
