---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { placeholderSvg } from '../lib/placeholder';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { title, summary, cover, tags } = project.data;
---

<!--
  The link wraps only the title and a ::after overlay stretches its hit area over the card. A link
  wrapping the whole card would be named by the title alone only through aria-labelledby, which
  breaks WCAG 2.5.3 (axe label-content-name-mismatch: the visible summary and tags are not in the
  name). Here the link's text is its name, and a screen reader's link list reads just the titles.
-->
<article class="card">
  <div class="cover">
    {cover ? (
      <Image src={cover} width={640} height={360} densities={[1, 2]} alt="" />
    ) : (
      <img
        src={placeholderSvg(project.id, title)}
        width="640"
        height="360"
        alt=""
        loading="lazy"
        decoding="async"
      />
    )}
  </div>
  <div class="body">
    <h2 class="title">
      <a class="link" data-testid="project-card" href={`/projects/${project.id}/`}>
        {title}
      </a>
    </h2>
    <p class="summary">{summary}</p>
    {tags.length > 0 && (
      <ul class="tags">
        {tags.map((tag) => (
          <li class="tag mono">{tag}</li>
        ))}
      </ul>
    )}
  </div>
</article>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--surface);
    transition: border-color 0.15s ease;
  }

  .card:hover,
  .card:focus-within {
    border-color: var(--accent);
  }

  /* The ring goes around the whole card, not just the title the link is made of. */
  .card:has(.link:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .cover {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-bottom: 1px solid var(--border);
    background: var(--bg);
  }

  /* The <Image> component renders its <img> itself, so scoped selectors cannot reach it. */
  .cover :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .body {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: 14px 16px 16px;
  }

  .title {
    margin: 0 0 6px;
    font-size: 17px;
    font-weight: 650;
    line-height: 1.35;
  }

  /* Whole-card links opt out of the global underline; the title underlines on hover and focus. */
  .link {
    color: var(--text-1);
    text-decoration: none;
  }

  .link::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .link:focus-visible {
    outline: none;
  }

  .card:hover .link,
  .link:focus-visible {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  .summary {
    margin: 0 0 12px;
    color: var(--text-2);
    font-size: 14.5px;
    line-height: 1.55;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: auto 0 0;
    padding: 0;
    list-style: none;
  }

  .tag {
    padding: 1px 9px;
    border: 1px solid var(--accent-2);
    border-radius: 999px;
    color: var(--accent-2);
    font-size: 11.5px;
    line-height: 1.5;
  }

  @media print {
    .card {
      break-inside: avoid;
    }
  }
</style>
